<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.GenshinCraftMapper">
    
    <resultMap type="GenshinCraft" id="GenshinCraftResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="filterText"    column="filter_text"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="unlockRank"    column="unlock_rank"    />
        <result property="resultCount"    column="result_count"    />
        <result property="moraCost"    column="mora_cost"    />
    </resultMap>
    
    <resultMap type="GenshinCraftRecipe" id="GenshinCraftRecipeResult">
        <result property="id"    column="id"    />
        <result property="craftId"    column="craft_id"    />
        <result property="materialId"    column="material_id"    />
        <result property="materialName"    column="material_name"    />
        <result property="materialCount"    column="material_count"    />
        <result property="isAlt"    column="is_alt"    />
    </resultMap>

    <sql id="selectGenshinCraftVo">
        select id, name, filter_text, sort_order, unlock_rank, result_count, mora_cost from genshin_craft
    </sql>
    
    <sql id="selectGenshinCraftRecipeVo">
        select id, craft_id, material_id, material_name, material_count, is_alt from genshin_craft_recipe
    </sql>

    <select id="selectGenshinCraftList" parameterType="GenshinCraft" resultMap="GenshinCraftResult">
        <include refid="selectGenshinCraftVo"/>
        <where>  
            <if test="name != null and name != ''"> and name like concat('%', #{name}, '%')</if>
        </where>
    </select>
    
    <select id="selectGenshinCraftById" parameterType="Long" resultMap="GenshinCraftResult">
        <include refid="selectGenshinCraftVo"/>
        where id = #{id}
    </select>
    
    <select id="selectGenshinCraftByName" parameterType="String" resultMap="GenshinCraftResult">
        <include refid="selectGenshinCraftVo"/>
        where name = #{name}
        limit 1
    </select>
    
    <select id="selectGenshinCraftRecipeByCraftId" parameterType="Long" resultMap="GenshinCraftRecipeResult">
        <include refid="selectGenshinCraftRecipeVo"/>
        where craft_id = #{craftId}
        and (is_alt is null or is_alt = 0)
    </select>

</mapper>
